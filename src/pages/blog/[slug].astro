---
import BlogPost from '../../components/pages/BlogPost.astro';
import { getPosts, entrySlug } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts
		.filter((post) => post.data.lang === 'zh-cn')
		.map((post) => ({
			params: { slug: entrySlug(post.id) },
			props: { post },
		}));
}

const { post } = Astro.props;
---

<BlogPost lang="zh-cn" post={post} />
