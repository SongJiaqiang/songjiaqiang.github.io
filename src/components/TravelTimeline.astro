---
import type { CollectionEntry } from 'astro:content';
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { formatMonth, travelTimelineItems } from '../lib/content';
import TravelTimelineNode from './TravelTimelineNode.astro';

interface Props {
	year: number;
	posts: CollectionEntry<'travel'>[];
	lang: Lang;
}

const { year, posts, lang } = Astro.props;
const t = useTranslations(lang);
const items = travelTimelineItems(posts);
---

<div class="mt-6" data-travel-timeline data-year={year}>
	<div class="overflow-x-auto pb-2">
		<div class="relative min-w-max px-2 py-1">
			<div
				class="bg-border pointer-events-none absolute top-[6px] right-8 left-8 h-px"
				aria-hidden="true"
			>
			</div>
			<ol class="relative flex list-none items-start gap-6">
				{
					items.map((item) =>
						item.type === 'post' ? (
							<li class="shrink-0">
								<TravelTimelineNode post={item.post} lang={lang} />
							</li>
						) : (
							<li class="flex shrink-0 items-start gap-4" data-month-group>
								<button
									type="button"
									data-month-toggle
									aria-expanded="false"
									aria-label={`${t('expandMonth')}: ${formatMonth(new Date(item.year, item.month, 1), lang)}`}
									data-label-expand={t('expandMonth')}
									data-label-collapse={t('collapseMonth')}
									data-month-name={formatMonth(new Date(item.year, item.month, 1), lang)}
									class="flex min-w-20 appearance-none flex-col items-center border-0 bg-transparent px-1 text-center font-[inherit] hover:text-accent"
								>
									<span class="size-3 rounded-full bg-accent" aria-hidden="true"></span>
									<span class="mt-2 text-xs whitespace-nowrap">
										{formatMonth(new Date(item.year, item.month, 1), lang)} · {item.posts.length}
									</span>
								</button>
								<ol class="hidden list-none items-start gap-6" data-month-posts>
									{item.posts.map((post) => (
										<li class="shrink-0">
											<TravelTimelineNode post={post} lang={lang} />
										</li>
									))}
								</ol>
							</li>
						),
					)
				}
			</ol>
		</div>
	</div>
</div>

<script>
	function seekJourney(slug: string) {
		const card = document.getElementById(`journey-${slug}`);
		if (!card) return;
		card.scrollIntoView({ behavior: 'smooth', block: 'center' });
		card.classList.add('travel-card-active');
		window.setTimeout(() => card.classList.remove('travel-card-active'), 1600);
	}

	function bindTravelTimelines() {
		document.querySelectorAll<HTMLElement>('[data-travel-timeline]').forEach((timeline) => {
			if (timeline.dataset.bound === 'true') return;
			timeline.dataset.bound = 'true';

			timeline.addEventListener('click', (event) => {
				const target = event.target as HTMLElement | null;
				const seek = target?.closest<HTMLElement>('[data-seek]');
				if (seek?.dataset.seek) {
					seekJourney(seek.dataset.seek);
					return;
				}

				const toggle = target?.closest<HTMLButtonElement>('[data-month-toggle]');
				if (!toggle) return;

				const group = toggle.closest('[data-month-group]');
				const posts = group?.querySelector<HTMLElement>('[data-month-posts]');
				if (!posts) return;

				const expanded = toggle.getAttribute('aria-expanded') === 'true';
				const next = !expanded;
				toggle.setAttribute('aria-expanded', String(next));
				posts.classList.toggle('hidden', !next);
				posts.classList.toggle('flex', next);

				const monthName = toggle.dataset.monthName ?? '';
				const label = next ? toggle.dataset.labelCollapse : toggle.dataset.labelExpand;
				if (label) toggle.setAttribute('aria-label', `${label}: ${monthName}`);
			});
		});
	}

	bindTravelTimelines();
	document.addEventListener('astro:after-swap', bindTravelTimelines);
</script>
