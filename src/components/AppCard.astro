---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { appPath, docsPath } from '../lib/content';

interface Props {
	app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const t = useTranslations(app.data.lang);
const statusLabel = app.data.status === 'active' ? t('statusActive') : t('statusArchived');
---

<li class="my-6">
	<a
		href={appPath(app)}
		class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
	>
		<h3>{app.data.name}</h3>
	</a>
	<p class="text-sm italic opacity-80">{statusLabel} · {app.data.tagline}</p>
	<p>{app.data.summary}</p>
	<div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
		<a href={appPath(app)} class="underline decoration-dashed underline-offset-4 hover:text-accent">
			{t('readMore')}
		</a>
		<a
			href={docsPath(app.data.docs, app.data.lang)}
			class="underline decoration-dashed underline-offset-4 hover:text-accent"
		>
			{t('openDocs')}
		</a>
	</div>
</li>
