---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { appPath, docsPath } from '../lib/content';

interface Props {
	app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const t = useTranslations(app.data.lang);
const statusLabel = app.data.status === 'active' ? t('statusActive') : t('statusArchived');
---

<li class="my-6">
	<div class="flex items-center gap-4">
		{
			app.data.icon && (
				<img
					src={app.data.icon}
					alt=""
					class="border-border size-14 shrink-0 rounded-xl border object-cover sm:size-16"
				/>
			)
		}
		<a
			href={appPath(app)}
			class="text-accent min-w-0 text-lg leading-none font-medium decoration-dashed underline-offset-4 hover:underline"
		>
			<h3 class="m-0 leading-none">{app.data.name}</h3>
		</a>
	</div>
	<div class="mt-1 ms-[4.5rem] sm:ms-20">
		<p class="text-sm italic opacity-80">{statusLabel} · {app.data.tagline}</p>
		<p>{app.data.summary}</p>
		<div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
			<a href={appPath(app)} class="underline decoration-dashed underline-offset-4 hover:text-accent">
				{t('readMore')}
			</a>
			{
				app.data.links.appStore ? (
					<a
						href={app.data.links.appStore}
						class="underline decoration-dashed underline-offset-4 hover:text-accent"
						rel="noreferrer"
					>
						{t('appStore')}
					</a>
				) : (
					app.data.links.github && (
						<a
							href={app.data.links.github}
							class="underline decoration-dashed underline-offset-4 hover:text-accent"
							rel="noreferrer"
						>
							GitHub
						</a>
					)
				)
			}
			<a
				href={docsPath(app.data.docs, app.data.lang)}
				class="underline decoration-dashed underline-offset-4 hover:text-accent"
			>
				{t('openDocs')}
			</a>
		</div>
	</div>
</li>
