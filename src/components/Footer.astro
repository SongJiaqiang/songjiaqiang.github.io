---
import { type Lang } from '../i18n/ui';
import { switchLocalePath, useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
const otherLang = lang === 'en' ? 'zh-cn' : 'en';
const otherHref = switchLocalePath(Astro.url.pathname, otherLang);
const langIcon = otherLang === 'en' ? 'En' : '中';
---

<footer class="app-layout mt-auto">
	<div
		class="border-border flex flex-col items-center justify-between gap-3 border-t py-6 sm:flex-row-reverse sm:py-4"
	>
		<div class="flex items-center gap-1">
			<a
				class="inline-flex size-8 items-center justify-center hover:text-accent"
				href={rssHref}
				title={t('rss')}
				aria-label={t('rss')}
			>
				<svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M4 11a9 9 0 0 1 9 9"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"></path>
					<path
						d="M4 4a16 16 0 0 1 16 16"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"></path>
					<circle cx="5" cy="19" r="1.5" fill="currentColor"></circle>
				</svg>
			</a>
			<a
				class="inline-flex size-8 items-center justify-center hover:text-accent"
				href="https://github.com/SongJiaqiang"
				title="GitHub"
				aria-label="GitHub"
			>
				<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10Z"
					></path>
				</svg>
			</a>
			<a
				class="inline-flex size-8 items-center justify-center text-sm font-semibold hover:text-accent"
				href={otherHref}
				title={t('langSwitch')}
				aria-label={t('langSwitch')}
			>
				{langIcon}
			</a>
			<button
				id="theme-btn"
				class="relative size-8 hover:text-accent"
				title={t('toggleTheme')}
				aria-label={t('toggleTheme')}
				aria-live="polite"
			>
				<svg
					class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linejoin="round"></path>
				</svg>
				<svg
					class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.75"></circle>
					<path
						d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
		<p class="my-2 text-sm text-muted-foreground">
			{t('footerNote')} · 2020–{year}
		</p>
	</div>
</footer>

<script>
	import '../scripts/theme';
</script>
