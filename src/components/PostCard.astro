---
import type { CollectionEntry } from 'astro:content';
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { formatDate, postPath } from '../lib/content';

interface Props {
	post: CollectionEntry<'blog'>;
	lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="rounded-2xl border border-ink/10 bg-white/50 p-5 transition-colors hover:border-water/40">
	<a href={postPath(post, lang)} class="block">
		<p class="text-xs tracking-wide text-water">{formatDate(post.data.pubDate, lang)}</p>
		<h3 class="mt-1 font-serif text-xl text-ink">{post.data.title}</h3>
		<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">{post.data.description}</p>
	</a>
	{
		post.data.tags.length > 0 && (
			<ul class="mt-3 flex flex-wrap gap-2">
				{post.data.tags.map((tag) => (
					<li>
						<a
							href={`${lang === 'en' ? '/en' : ''}/blog/tags/${tag}`}
							class="rounded-full bg-foam px-2.5 py-0.5 text-xs text-water-deep"
						>
							{tag}
						</a>
					</li>
				))}
			</ul>
		)
	}
	{
		lang === 'en' && post.data.lang === 'zh-cn' && (
			<p class="mt-3 text-xs text-ink-soft">{t('chineseOnly')}</p>
		)
	}
</article>
