---
import type { CollectionEntry } from 'astro:content';
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { formatDate, postPath } from '../lib/content';

interface Props {
	post: CollectionEntry<'blog'>;
	lang: Lang;
	heading?: 'h2' | 'h3';
}

const { post, lang, heading: Heading = 'h3' } = Astro.props;
const t = useTranslations(lang);
---

<li class="my-6">
	<a
		href={postPath(post, lang)}
		class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
	>
		<Heading>{post.data.title}</Heading>
	</a>
	<div class="text-sm italic opacity-80">
		{t('postedOn')} {formatDate(post.data.pubDate, lang)}
	</div>
	<p>{post.data.description}</p>
	{
		post.data.tags.length > 0 && (
			<ul class="mt-1 flex list-none flex-wrap gap-x-3 gap-y-1 text-sm">
				{post.data.tags.map((tag) => (
					<li>
						<a
							href={`${lang === 'en' ? '/en' : ''}/blog/tags/${tag}`}
							class="text-muted-foreground hover:text-accent"
						>
							#{tag}
						</a>
					</li>
				))}
			</ul>
		)
	}
	{
		lang === 'en' && post.data.lang === 'zh-cn' && (
			<p class="mt-1 text-sm text-muted-foreground">{t('chineseOnly')}</p>
		)
	}
</li>
