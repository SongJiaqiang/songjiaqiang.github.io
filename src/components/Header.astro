---
import { type Lang } from '../i18n/ui';
import { localizedPath, useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	pathname: string;
	variant?: 'site' | 'docs';
}

const { lang, pathname, variant = 'site' } = Astro.props;
const t = useTranslations(lang);
const skipHref = variant === 'docs' ? '#_top' : '#main-content';

const links = [
	{ href: localizedPath(lang, '/blog'), label: t('navBlog') },
	{ href: localizedPath(lang, '/apps'), label: t('navApps') },
	{ href: localizedPath(lang, '/travel'), label: t('navTravel') },
	{ href: localizedPath(lang, '/about'), label: t('navAbout') },
];

function isActive(href: string) {
	const current = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
	const target = href.endsWith('/') && href !== '/' ? href.slice(0, -1) : href;
	if (target === localizedPath(lang, '/')) return current === target;
	return current === target || current.startsWith(`${target}/`);
}
---

<a
	id="skip-to-content"
	href={skipHref}
	class="bg-background text-accent absolute -top-full z-50 px-3 py-2 focus:top-4"
>
	{t('skipToContent')}
</a>

<header class="app-layout flex flex-col items-center justify-between sm:flex-row">
	<div
		class="border-border relative flex w-full items-baseline justify-between border-b py-4 sm:items-center sm:py-6"
	>
		<a
			href={localizedPath(lang, '/')}
			class="absolute start-0 py-1 text-xl leading-8 font-semibold whitespace-nowrap text-foreground no-underline hover:text-accent sm:static sm:text-2xl sm:leading-none"
		>
			{t('navHome')}
		</a>
		<nav id="nav-menu" class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end">
			<button
				id="menu-btn"
				class="self-end p-2 sm:hidden"
				aria-label={t('openMenu')}
				aria-expanded="false"
				aria-controls="menu-items"
				data-label-open={t('openMenu')}
				data-label-close={t('closeMenu')}
			>
				<svg id="close-icon" class="hidden size-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
				</svg>
				<svg id="menu-icon" class="size-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
				</svg>
			</button>
			<ul
				id="menu-items"
				class="mt-4 hidden w-44 list-none grid-cols-2 place-content-center gap-2 sm:mt-0 sm:flex sm:w-auto sm:items-center sm:gap-x-5 [&>li>a]:block [&>li>a]:px-2 [&>li>a]:py-1 [&>li>a]:font-medium [&>li>a]:hover:text-accent"
			>
				{
					links.map((link) => (
						<li class="col-span-2">
							<a href={link.href} class:list={{ 'active-nav': isActive(link.href) }}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	function toggleNav() {
		const menuBtn = document.querySelector<HTMLButtonElement>('#menu-btn');
		const menuItems = document.querySelector('#menu-items');
		const menuIcon = document.querySelector('#menu-icon');
		const closeIcon = document.querySelector('#close-icon');

		if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

		const openLabel = menuBtn.dataset.labelOpen ?? 'Open menu';
		const closeLabel = menuBtn.dataset.labelClose ?? 'Close menu';

		menuBtn.addEventListener('click', () => {
			const openMenu = menuBtn.getAttribute('aria-expanded') === 'true';
			menuBtn.setAttribute('aria-expanded', openMenu ? 'false' : 'true');
			menuBtn.setAttribute('aria-label', openMenu ? openLabel : closeLabel);
			menuItems.classList.toggle('hidden');
			menuItems.classList.toggle('grid');
			menuIcon.classList.toggle('hidden');
			closeIcon.classList.toggle('hidden');
		});
	}

	toggleNav();
	document.addEventListener('astro:after-swap', toggleNav);
</script>
