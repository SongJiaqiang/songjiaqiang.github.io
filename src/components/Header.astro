---
import { type Lang } from '../i18n/ui';
import { localizedPath, switchLocalePath, useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	pathname: string;
	variant?: 'site' | 'docs';
}

const { lang, pathname, variant = 'site' } = Astro.props;
const t = useTranslations(lang);
const otherLang = lang === 'en' ? 'zh-cn' : 'en';
const otherHref = switchLocalePath(pathname, otherLang);

const links = [
	{ href: localizedPath(lang, '/blog'), label: t('navBlog') },
	{ href: localizedPath(lang, '/apps'), label: t('navApps') },
	{ href: localizedPath(lang, '/docs'), label: t('navDocs') },
	{ href: localizedPath(lang, '/about'), label: t('navAbout') },
];

function isActive(href: string) {
	const current = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
	const target = href.endsWith('/') && href !== '/' ? href.slice(0, -1) : href;
	if (target === localizedPath(lang, '/')) return current === target;
	return current === target || current.startsWith(`${target}/`);
}
---

<header
	class:list={[
		'site-header sticky top-0 z-40 border-b border-ink/10',
		variant === 'docs' ? 'bg-paper/90' : 'bg-paper/80',
	]}
>
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3.5">
		<a href={localizedPath(lang, '/')} class="group flex min-w-0 items-center gap-2.5">
			<svg class="h-7 w-7 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
				<path
					d="M32 6C32 6 12 28.5 12 40.5C12 51.5 20.5 58 32 58C43.5 58 52 51.5 52 40.5C52 28.5 32 6 32 6Z"
					fill="#1c6b78"></path>
				<path
					d="M24 38C24 38 26 30 32 26"
					stroke="#dceeee"
					stroke-width="3"
					stroke-linecap="round"></path>
			</svg>
			<span class="min-w-0">
				<span class="block font-serif text-lg leading-none text-ink">{t('siteTitle')}</span>
				<span class="mt-1 hidden text-xs tracking-wide text-ink-soft sm:block">{t('siteSubtitle')}</span>
			</span>
		</a>
		<nav class="flex items-center gap-1 text-sm sm:gap-2">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={[
							'rounded-full px-2.5 py-1.5 transition-colors sm:px-3',
							isActive(link.href)
								? 'bg-water text-paper'
								: 'text-ink-soft hover:bg-foam hover:text-ink',
						]}
					>
						{link.label}
					</a>
				))
			}
			<a
				href={otherHref}
				class="ml-1 rounded-full border border-ink/15 px-2.5 py-1.5 text-ink-soft hover:border-water hover:text-water"
			>
				{t('langSwitch')}
			</a>
		</nav>
	</div>
</header>
