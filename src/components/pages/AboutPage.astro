---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const webLinks = [
	{ label: 'GitHub', href: 'https://github.com/SongJiaqiang' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@宋千里-sql' },
	{ label: 'Instagram', href: 'https://www.instagram.com/song_qian_li/' },
	{ label: 'TikTok', href: 'https://www.tiktok.com/@song.qianli' },
	{ label: lang === 'en' ? 'Douyin' : '抖音', href: 'https://v.douyin.com/Q3Mu50Pmv5U/' },
	{ label: 'Bilibili', href: 'https://space.bilibili.com/476824893' },
];
---

<BaseLayout lang={lang} title={t('aboutTitle')} description={t('aboutBody')}>
	<article class="pt-8 pb-6">
		<h1 class="text-4xl font-bold">{t('aboutTitle')}</h1>
		<p class="app-prose mt-6">{t('aboutBody')}</p>
		<h2 class="mt-10 text-2xl font-semibold tracking-wide">{t('aboutLinks')}</h2>
		<ul class="mt-4 list-none space-y-2">
			{
				webLinks.map((link) => (
					<li>
						<a href={link.href} rel="noreferrer" class="underline decoration-dashed underline-offset-4 hover:text-accent">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</article>
</BaseLayout>
