---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../i18n/ui';
import { localizedPath, useTranslations } from '../../i18n/utils';
import { formatDate } from '../../lib/content';

interface Props {
	lang: Lang;
	post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.description}>
	<article class="pt-8 pb-6">
		{
			lang === 'en' && post.data.lang === 'zh-cn' && (
				<p class="border-accent/80 mb-6 border-s-4 ps-3 text-sm opacity-80">{t('chineseOnly')}</p>
			)
		}
		<p class="text-sm italic opacity-80">
			{t('postedOn')} {formatDate(post.data.pubDate, lang)}
		</p>
		<h1 class="mt-2 text-4xl leading-tight font-bold">{post.data.title}</h1>
		{
			post.data.tags.length > 0 && (
				<ul class="mt-4 flex list-none flex-wrap gap-x-3 gap-y-1 text-sm">
					{post.data.tags.map((tag) => (
						<li>
							<a
								href={localizedPath(lang, `/blog/tags/${tag}`)}
								class="text-muted-foreground underline decoration-dashed underline-offset-4 hover:text-accent"
							>
								#{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		{
			post.data.cover && (
				<img src={post.data.cover} alt="" class="border-border mt-8 w-full border object-cover" />
			)
		}
		<div class="app-prose mt-8">
			<Content />
		</div>
	</article>
</BaseLayout>
