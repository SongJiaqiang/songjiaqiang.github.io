---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../i18n/ui';
import { localizedPath, useTranslations } from '../../i18n/utils';
import { formatDate } from '../../lib/content';

interface Props {
	lang: Lang;
	post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.description}>
	<article class="max-w-3xl">
		{
			lang === 'en' && post.data.lang === 'zh-cn' && (
				<p class="mb-4 rounded-xl bg-foam px-4 py-2 text-sm text-water-deep">{t('chineseOnly')}</p>
			)
		}
		<p class="text-sm text-water">
			{t('postedOn')} {formatDate(post.data.pubDate, lang)}
		</p>
		<h1 class="mt-2 font-serif text-4xl leading-tight">{post.data.title}</h1>
		{
			post.data.tags.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-2">
					{post.data.tags.map((tag) => (
						<li>
							<a
								href={localizedPath(lang, `/blog/tags/${tag}`)}
								class="rounded-full bg-foam px-2.5 py-0.5 text-xs text-water-deep"
							>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		{
			post.data.cover && (
				<img src={post.data.cover} alt="" class="mt-8 w-full rounded-2xl object-cover" />
			)
		}
		<div class="prose-water mt-8">
			<Content />
		</div>
	</article>
</BaseLayout>
