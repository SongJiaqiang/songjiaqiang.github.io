---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCard from '../AppCard.astro';
import { type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getApps } from '../../lib/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const apps = await getApps(lang);
---

<BaseLayout lang={lang} title={t('navApps')} description={t('heroLead')}>
	<header class="border-border border-b pt-8 pb-6">
		<h1 class="text-4xl font-bold">{t('navApps')}</h1>
		<p class="mt-3">{t('docsHubLead')}</p>
	</header>
	{
		apps.length === 0 ? (
			<p class="mt-8 text-muted-foreground">{t('noApps')}</p>
		) : (
			<ul class="list-none">
				{apps.map((app) => (
					<AppCard app={app} />
				))}
			</ul>
		)
	}
</BaseLayout>
