---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import { type Lang } from '../../i18n/ui';
import { localizedPath, useTranslations } from '../../i18n/utils';
import { getPosts } from '../../lib/content';

interface Props {
	lang: Lang;
	tag?: string;
}

const { lang, tag } = Astro.props;
const t = useTranslations(lang);
const allPosts = await getPosts();
const localizedPosts = allPosts.filter((post) => post.data.lang === lang);
const posts = (localizedPosts.length > 0 ? localizedPosts : allPosts).filter(
	(post) => !tag || post.data.tags.includes(tag),
);
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
const title = tag ? `${t('tags')} · ${tag}` : t('navBlog');
---

<BaseLayout lang={lang} title={title}>
	<header class="max-w-2xl">
		<h1 class="font-serif text-4xl">{t('navBlog')}</h1>
		{
			lang === 'en' && localizedPosts.length === 0 && (
				<p class="mt-3 text-ink-soft">{t('emptyEnBlog')}</p>
			)
		}
	</header>

	{
		tags.length > 0 && (
			<ul class="mt-6 flex flex-wrap gap-2">
				<li>
					<a
						href={localizedPath(lang, '/blog')}
						class:list={[
							'rounded-full px-3 py-1 text-sm',
							!tag ? 'bg-water text-paper' : 'bg-foam text-water-deep',
						]}
					>
						{t('allTags')}
					</a>
				</li>
				{tags.map((item) => (
					<li>
						<a
							href={localizedPath(lang, `/blog/tags/${item}`)}
							class:list={[
								'rounded-full px-3 py-1 text-sm',
								tag === item ? 'bg-water text-paper' : 'bg-foam text-water-deep',
							]}
						>
							{item}
						</a>
					</li>
				))}
			</ul>
		)
	}

	<div class="mt-8 grid gap-4">
		{posts.length === 0 ? <p class="text-ink-soft">{t('noPosts')}</p> : posts.map((post) => <PostCard post={post} lang={lang} />)}
	</div>
</BaseLayout>
