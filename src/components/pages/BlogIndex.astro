---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import { type Lang } from '../../i18n/ui';
import { localizedPath, useTranslations } from '../../i18n/utils';
import { getPosts } from '../../lib/content';

interface Props {
	lang: Lang;
	tag?: string;
}

const { lang, tag } = Astro.props;
const t = useTranslations(lang);
const allPosts = await getPosts();
const localizedPosts = allPosts.filter((post) => post.data.lang === lang);
const posts = (localizedPosts.length > 0 ? localizedPosts : allPosts).filter(
	(post) => !tag || post.data.tags.includes(tag),
);
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
const title = tag ? `${t('tags')} · ${tag}` : t('navBlog');
---

<BaseLayout lang={lang} title={title}>
	<header class="border-border border-b pt-8 pb-6">
		<h1 class="text-4xl font-bold">{t('navBlog')}</h1>
		{
			lang === 'en' && localizedPosts.length === 0 && (
				<p class="mt-3 text-muted-foreground">{t('emptyEnBlog')}</p>
			)
		}
	</header>

	{
		tags.length > 0 && (
			<ul class="mt-6 flex list-none flex-wrap gap-x-4 gap-y-2 text-sm">
				<li>
					<a
						href={localizedPath(lang, '/blog')}
						class:list={[
							'underline decoration-dashed underline-offset-4 hover:text-accent',
							!tag && 'text-accent',
						]}
					>
						{t('allTags')}
					</a>
				</li>
				{tags.map((item) => (
					<li>
						<a
							href={localizedPath(lang, `/blog/tags/${item}`)}
							class:list={[
								'underline decoration-dashed underline-offset-4 hover:text-accent',
								tag === item && 'text-accent',
							]}
						>
							#{item}
						</a>
					</li>
				))}
			</ul>
		)
	}

	{
		posts.length === 0 ? (
			<p class="mt-8 text-muted-foreground">{t('noPosts')}</p>
		) : (
			<ul class="mt-4 list-none">
				{posts.map((post) => (
					<PostCard post={post} lang={lang} />
				))}
			</ul>
		)
	}
</BaseLayout>
