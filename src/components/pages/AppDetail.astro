---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { docsPath } from '../../lib/content';

interface Props {
	app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const lang = app.data.lang;
const t = useTranslations(lang);
const { Content } = await render(app);
const statusLabel = app.data.status === 'active' ? t('statusActive') : t('statusArchived');
---

<BaseLayout lang={lang} title={app.data.name} description={app.data.tagline}>
	<article class="pt-8 pb-6">
		<p class="text-sm italic opacity-80">{statusLabel}</p>
		<h1 class="mt-2 text-4xl font-bold">{app.data.name}</h1>
		<p class="mt-3 text-lg">{app.data.tagline}</p>
		<p class="mt-2 text-muted-foreground">{app.data.summary}</p>
		<div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
			<a
				href={docsPath(app.data.docs, lang)}
				class="text-accent underline decoration-dashed underline-offset-4 hover:underline"
			>
				{t('openDocs')}
			</a>
			{
				app.data.links.github && (
					<a href={app.data.links.github} class="underline decoration-dashed underline-offset-4 hover:text-accent">
						{t('viewSource')}
					</a>
				)
			}
			{
				app.data.links.appStore && (
					<a href={app.data.links.appStore} class="underline decoration-dashed underline-offset-4 hover:text-accent">
						{t('appStore')}
					</a>
				)
			}
			{
				app.data.links.play && (
					<a href={app.data.links.play} class="underline decoration-dashed underline-offset-4 hover:text-accent">
						{t('playStore')}
					</a>
				)
			}
			{
				app.data.links.website && (
					<a href={app.data.links.website} class="underline decoration-dashed underline-offset-4 hover:text-accent">
						{t('visitSite')}
					</a>
				)
			}
		</div>
		{
			app.data.hero && (
				<img src={app.data.hero} alt="" class="border-border mt-8 w-full border object-cover" />
			)
		}
		<div class="app-prose mt-8">
			<Content />
		</div>
	</article>
</BaseLayout>
