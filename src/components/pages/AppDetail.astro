---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { docsPath } from '../../lib/content';

interface Props {
	app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const lang = app.data.lang;
const t = useTranslations(lang);
const { Content } = await render(app);
const statusLabel = app.data.status === 'active' ? t('statusActive') : t('statusArchived');
---

<BaseLayout lang={lang} title={app.data.name} description={app.data.tagline}>
	<article class="max-w-3xl">
		<p class="text-xs uppercase tracking-[0.2em] text-water">{app.data.name}</p>
		<h1 class="mt-2 font-serif text-4xl">{app.data.tagline}</h1>
		<p class="mt-3 text-lg text-ink-soft">{app.data.summary}</p>
		<div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
			<span class="rounded-full bg-foam px-3 py-1 text-water-deep">{statusLabel}</span>
			<a href={docsPath(app.data.docs, lang)} class="rounded-full bg-water px-4 py-1.5 text-paper hover:bg-water-deep">
				{t('openDocs')}
			</a>
			{
				app.data.links.github && (
					<a href={app.data.links.github} class="rounded-full border border-ink/15 px-4 py-1.5">
						{t('viewSource')}
					</a>
				)
			}
			{
				app.data.links.appStore && (
					<a href={app.data.links.appStore} class="rounded-full border border-ink/15 px-4 py-1.5">
						{t('appStore')}
					</a>
				)
			}
			{
				app.data.links.play && (
					<a href={app.data.links.play} class="rounded-full border border-ink/15 px-4 py-1.5">
						{t('playStore')}
					</a>
				)
			}
			{
				app.data.links.website && (
					<a href={app.data.links.website} class="rounded-full border border-ink/15 px-4 py-1.5">
						{t('visitSite')}
					</a>
				)
			}
		</div>
		{
			app.data.hero && (
				<img src={app.data.hero} alt="" class="mt-8 w-full rounded-2xl object-cover" />
			)
		}
		<div class="prose-water mt-8">
			<Content />
		</div>
	</article>
</BaseLayout>
