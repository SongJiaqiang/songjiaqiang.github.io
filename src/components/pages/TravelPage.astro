---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TravelJournal from '../react/TravelJournal';
import { type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getTravelPosts, toTravelStory } from '../../lib/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allPosts = await getTravelPosts();
const localizedPosts = allPosts.filter((post) => post.data.lang === lang);
const posts = localizedPosts.length > 0 ? localizedPosts : allPosts;
const stories = posts.map((post) => toTravelStory(post, lang));
const notice =
	lang === 'en' && localizedPosts.length === 0 && posts.length > 0 ? t('emptyEnTravel') : undefined;
---

<BaseLayout lang={lang} title={t('navTravel')} layout="wide">
	{
		posts.length === 0 ? (
			<p class="mt-8 text-muted-foreground">{t('noTravel')}</p>
		) : (
			<TravelJournal
				client:load
				stories={stories}
				lang={lang}
				labels={{
					title: t('travelJournalTitle'),
					yearExplorations: t('yearExplorations'),
					yearJourneys: t('yearJourneys'),
					tripNotes: t('tripNotes'),
					durationDays: t('durationDays'),
					photos: t('photos'),
					videos: t('videos'),
					map: t('map'),
					timeline: t('travelTimeline'),
				}}
				notice={notice}
			/>
		)
	}
</BaseLayout>

<style>
	:global(#main-content astro-island) {
		display: contents;
	}
</style>
