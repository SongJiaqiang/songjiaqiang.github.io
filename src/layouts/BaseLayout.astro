---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	layout?: 'default' | 'wide';
}

const { lang, title, description, layout = 'default' } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${t('siteTitle')}` : `${t('siteTitle')} · ${t('siteSubtitle')}`;
const pageDescription = description ?? t('heroLead');
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fdfdfd" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline src="/theme-init.js"></script>
		<link rel="alternate" type="application/rss+xml" title={t('siteTitle')} href={rssHref} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
	</head>
	<body
		class:list={[
			'flex flex-col bg-background text-foreground',
			layout === 'wide' ? 'h-[100dvh] overflow-hidden' : 'min-h-screen',
		]}
	>
		<div class="shrink-0">
			<Header lang={lang} pathname={Astro.url.pathname} />
		</div>
		<main
			id="main-content"
			class:list={[
				'my-1 min-h-0 flex-1',
				layout === 'wide' ? 'app-layout-wide flex flex-col overflow-hidden' : 'app-layout',
			]}
		>
			<slot />
		</main>
		<div class="shrink-0">
			<Footer lang={lang} />
		</div>
	</body>
</html>
