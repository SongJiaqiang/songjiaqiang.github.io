---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${t('siteTitle')}` : `${t('siteTitle')} · ${t('siteSubtitle')}`;
const pageDescription = description ?? t('heroLead');
---

<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" type="application/rss+xml" title={t('siteTitle')} href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
	</head>
	<body class="site-shell">
		<Header lang={lang} pathname={Astro.url.pathname} />
		<main class="mx-auto w-full max-w-5xl px-5 py-10">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
